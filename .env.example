PORT=3000
HOST=0.0.0.0

# dummy | azure-key-vault
SECRETS_PROVIDER=dummy

# required when SECRETS_PROVIDER=azure-key-vault
KEY_VAULT_URL=

# base URL of the published spacy-nlp-service (POST {url}/process)
SPACY_SERVICE_URL=https://spacy-nlp-services-g4d2efhqa0cgdbaj.canadacentral-01.azurewebsites.net/
# Default Box folder for generated audio (folder id, not a secret). Optional
# if every generate call passes boxFolderId.
BOX_AUDIO_FOLDER_ID=
# Claude model for the scaffolding translation sanity check (optional; the
# API key is the "anthropic-api-key" secret, not an env var).
ANTHROPIC_REVIEW_MODEL=claude-sonnet-5-5

# used only by drizzle-kit (migrations), never by the running app
MIGRATION_DATABASE_URL=postgres://user:password@localhost:5432/localization_dev
