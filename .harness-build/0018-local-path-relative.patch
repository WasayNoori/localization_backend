From c4242bad1c125eb47d47e6de98b957b663c38cbe Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 6 Oct 2026 23:44:10 -0700
Subject: [PATCH] Audio POC: tts_clips.local_path relative to LOCAL_OUTPUT_ROOT
 (portable across machines/shells)

---
 docs/rationale/schema-guide.md              |  2 +-
 src/db/schema.ts                            |  3 ++-
 src/services/output/LocalFolderClipStore.ts | 14 +++++++-------
 3 files changed, 10 insertions(+), 9 deletions(-)

diff --git a/docs/rationale/schema-guide.md b/docs/rationale/schema-guide.md
index c4228f6..96be56c 100644
--- a/docs/rationale/schema-guide.md
+++ b/docs/rationale/schema-guide.md
@@ -395,7 +395,7 @@ One row per generated audio segment, in either English or a target language.
 | `audio_format`          | text           | e.g. `mp3_44100_192`                                                    |
 | `box_file_id`           | text, null     | Box file ID once uploaded                                              |
 | `box_file_path`         | text, null     | Human-readable path, for debugging without a Box API call             |
-| `local_path`            | text, null     | POC: where the clip was saved on disk (`LocalFolderClipStore`) while Box isn't set up; the Box backfill fills `box_file_id` from it |
+| `local_path`            | text, null     | POC: where the clip was saved on disk (`LocalFolderClipStore`), relative to `LOCAL_OUTPUT_ROOT` with `/` separators, while Box isn't set up; the Box backfill fills `box_file_id` from it |
 | `previous_text`         | text, null     | The `previous_text` actually sent to ElevenLabs (null at a lesson's first segment, or when the neighbor wasn't translated yet) |
 | `next_text`             | text, null     | Same for `next_text`                                                    |
 | `qc_status`             | text           | `pending` \| `pass` \| `warn` \| `fail` \| `manual_review` \| `superseded` |
diff --git a/src/db/schema.ts b/src/db/schema.ts
index 989005b..1b53670 100644
--- a/src/db/schema.ts
+++ b/src/db/schema.ts
@@ -388,7 +388,8 @@ export const ttsClips = pgTable(
     boxFileId: text("box_file_id"),
     boxFilePath: text("box_file_path"),
     // POC: where the clip was saved on disk while Box isn't set up
-    // (LocalFolderClipStore). A later Box upload fills box_file_id from it.
+    // (LocalFolderClipStore), relative to LOCAL_OUTPUT_ROOT with "/" separators.
+    // A later Box upload fills box_file_id from it.
     localPath: text("local_path"),
     // The previous_text / next_text actually sent to ElevenLabs for this clip
     // (null at a lesson boundary, or when the neighbor had no translation yet).
diff --git a/src/services/output/LocalFolderClipStore.ts b/src/services/output/LocalFolderClipStore.ts
index 5da5388..74bd32a 100644
--- a/src/services/output/LocalFolderClipStore.ts
+++ b/src/services/output/LocalFolderClipStore.ts
@@ -1,23 +1,23 @@
 // src/services/output/LocalFolderClipStore.ts
 import type { ClipDestination, IClipStore, StoredClip } from "../../interfaces/IClipStore.js";
 import type { ILessonOutputStore } from "../../interfaces/ILessonOutputStore.js";
+import { clipFilePath } from "./outputLayout.js";
 
 /**
  * POC: saves clips into the local course folder layout
  * (<courseFolder>/<Language>/<lessonId>/<Language> Clips/<lessonId>_<lang>_NNN.mp3)
  * until the Box app is registered. box_file_id stays null; local_path is
- * what a later Box upload backfills from.
+ * what a later Box upload backfills from — stored relative to the output
+ * root ("SOLIDWORKS Simulation/French/25Sim01_01/French Clips/25Sim01_01_fr_001.mp3"),
+ * so it reads the same whichever machine or shell ran the generation.
  */
 export class LocalFolderClipStore implements IClipStore {
   constructor(private readonly outputStore: ILessonOutputStore) {}
 
   async save(destination: ClipDestination, audio: Buffer): Promise<StoredClip> {
     if (!destination.courseFolder) throw new Error("No course folder to save the clip into");
-    const localPath = await this.outputStore.writeClip(
-      { courseFolder: destination.courseFolder, language: destination.language, lessonId: destination.lessonId },
-      destination.segmentNumber,
-      audio
-    );
-    return { boxFileId: null, boxFilePath: null, localPath };
+    const target = { courseFolder: destination.courseFolder, language: destination.language, lessonId: destination.lessonId };
+    await this.outputStore.writeClip(target, destination.segmentNumber, audio);
+    return { boxFileId: null, boxFilePath: null, localPath: clipFilePath(target, destination.segmentNumber).join("/") };
   }
 }
-- 
