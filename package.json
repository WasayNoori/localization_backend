{
  "name": "localization-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "glossaries:sync": "tsx --env-file-if-exists=.env src/scripts/sync-glossaries.ts",
    "scripts:load": "tsx --env-file-if-exists=.env src/scripts/load-scripts.ts",
    "course:translate": "tsx --env-file-if-exists=.env src/scripts/translate-course.ts",
    "outputs:segments": "tsx --env-file-if-exists=.env src/scripts/write-segments.ts",
    "audio:generate": "tsx --env-file-if-exists=.env src/scripts/generate-audio.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@fastify/swagger": "^9.8.0",
    "@fastify/swagger-ui": "^6.1.0",
    "box-typescript-sdk-gen": "^1.19.1",
    "drizzle-orm": "^0.33.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "postgres": "^3.4.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "drizzle-kit": "^0.24.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
